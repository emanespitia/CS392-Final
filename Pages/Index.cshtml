@page
@model IndexModel
@{
    ViewData["Title"] = "Store Products";
}

<div class="container py-4">
    <h1 class="mb-4">Store Product Manager</h1>
    <p class="text-muted">
    </p>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">Add Product</div>
                <div class="card-body">
                    <form id="createForm">
                        <div class="mb-2">
                            <label for="createName" class="form-label">Name</label>
                            <input id="createName" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label for="createCategory" class="form-label">Category</label>
                            <input id="createCategory" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label for="createPrice" class="form-label">Price</label>
                            <input id="createPrice" class="form-control" type="number" step="0.01" min="0" required />
                        </div>
                        <div class="form-check mb-3">
                            <input id="createInStock" class="form-check-input" type="checkbox" checked />
                            <label for="createInStock" class="form-check-label">In Stock</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Create Product</button>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">Update Product</div>
                <div class="card-body">
                    <form id="updateForm">
                        <div class="mb-2">
                            <label for="updateId" class="form-label">Product ID</label>
                            <input id="updateId" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label for="updateName" class="form-label">Name</label>
                            <input id="updateName" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label for="updateCategory" class="form-label">Category</label>
                            <input id="updateCategory" class="form-control" required />
                        </div>
                        <div class="mb-2">
                            <label for="updatePrice" class="form-label">Price</label>
                            <input id="updatePrice" class="form-control" type="number" step="0.01" min="0" required />
                        </div>
                        <div class="form-check mb-3">
                            <input id="updateInStock" class="form-check-input" type="checkbox" />
                            <label for="updateInStock" class="form-check-label">In Stock</label>
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Update Product</button>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">Delete Product</div>
                <div class="card-body">
                    <form id="deleteForm">
                        <div class="mb-3">
                            <label for="deleteId" class="form-label">Product ID</label>
                            <input id="deleteId" class="form-control" required />
                        </div>
                        <button type="submit" class="btn btn-danger w-100">Delete Product</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Products</h3>
                <button id="refreshBtn" class="btn btn-outline-secondary">Refresh</button>
            </div>
            <div id="statusMessage" class="alert d-none" role="alert"></div>
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>In Stock</th>
                        </tr>
                    </thead>
                    <tbody id="productsTableBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    const apiBase = "/api/products";
    const tableBody = document.getElementById("productsTableBody");
    const statusMessage = document.getElementById("statusMessage");

    function showMessage(text, isError = false) {
        statusMessage.textContent = text;
        statusMessage.className = `alert ${isError ? "alert-danger" : "alert-success"}`;
    }

    async function loadProducts() {
        const response = await fetch(apiBase);
        if (!response.ok) {
            throw new Error("Failed to fetch products.");
        }

        const products = await response.json();
        tableBody.innerHTML = "";

        for (const product of products) {
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${product.id ?? ""}</td>
                <td>${product.name ?? ""}</td>
                <td>${product.category ?? ""}</td>
                <td>$${Number(product.price ?? 0).toFixed(2)}</td>
                <td>${product.inStock ? "Yes" : "No"}</td>
            `;
            tableBody.appendChild(row);
        }
    }

    document.getElementById("refreshBtn").addEventListener("click", async () => {
        try {
            await loadProducts();
            showMessage("Products refreshed.");
        } catch (error) {
            showMessage(error.message, true);
        }
    });

    document.getElementById("createForm").addEventListener("submit", async (event) => {
        event.preventDefault();
        const payload = {
            name: document.getElementById("createName").value.trim(),
            category: document.getElementById("createCategory").value.trim(),
            price: Number(document.getElementById("createPrice").value),
            inStock: document.getElementById("createInStock").checked
        };

        const response = await fetch(apiBase, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            showMessage("Create failed.", true);
            return;
        }

        event.target.reset();
        document.getElementById("createInStock").checked = true;
        await loadProducts();
        showMessage("Product created successfully.");
    });

    document.getElementById("updateForm").addEventListener("submit", async (event) => {
        event.preventDefault();
        const id = document.getElementById("updateId").value.trim();
        const payload = {
            id,
            name: document.getElementById("updateName").value.trim(),
            category: document.getElementById("updateCategory").value.trim(),
            price: Number(document.getElementById("updatePrice").value),
            inStock: document.getElementById("updateInStock").checked
        };

        const response = await fetch(`${apiBase}/${id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        });

        if (!response.ok) {
            showMessage("Update failed. Confirm Product ID exists.", true);
            return;
        }

        await loadProducts();
        showMessage("Product updated successfully.");
    });

    document.getElementById("deleteForm").addEventListener("submit", async (event) => {
        event.preventDefault();
        const id = document.getElementById("deleteId").value.trim();
        const response = await fetch(`${apiBase}/${id}`, { method: "DELETE" });

        if (!response.ok) {
            showMessage("Delete failed. Confirm Product ID exists.", true);
            return;
        }

        event.target.reset();
        await loadProducts();
        showMessage("Product deleted successfully.");
    });

    loadProducts().catch((error) => showMessage(error.message, true));
</script>
